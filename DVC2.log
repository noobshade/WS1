DECLARE @Certificate varbinary(max);
DECLARE @CertificatePassword  varchar(255);

SELECT @Certificate=Certificate, @CertificatePassword=CertificatePassword
FROM dbo.Certificate
WHERE (CertificateThumbprint = @value)
   
IF (@Certificate IS NULL)
BEGIN
  SELECT TOP 1 @Certificate=Certificate, @CertificatePassword=CertificatePassword
  FROM dbo.Certificate
  WHERE (SubjectName = @value)
END

IF (@Certificate IS NULL)
BEGIN
  SELECT TOP 1 @Certificate=Certificate, @CertificatePassword=CertificatePassword
  FROM dbo.Certificate
  WHERE (SubjectName LIKE 'CN='+ @value + '%')
END

